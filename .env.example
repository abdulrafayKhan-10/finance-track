# Copy to .env.local and fill in. Never commit .env.local.
# Supabase dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The URL this app is served from (used in auth email links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Secret key (sb_secret_...) or legacy service_role key.
# Not needed yet: only used later for permanent account deletion. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
